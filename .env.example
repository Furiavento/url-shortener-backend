PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# Access token lifetime in seconds
JWT_EXPIRES_IN=900
# Generate with: openssl rand -hex 16
IP_HASH_SALT=change-me-random-salt
CORS_ORIGIN=http://localhost:4200
SHORT_URL_BASE=http://localhost:3000
# Refresh token lifetime in days (renewed on every refresh)
REFRESH_TOKEN_TTL_DAYS=7
# Defaults to true when NODE_ENV=production; must be true when COOKIE_SAMESITE=none
COOKIE_SECURE=false
# strict | lax | none
COOKIE_SAMESITE=strict
